  "item": [
    {
      "name": "Authentication",
      "description": "Endpoints for user registration, OTP email verification, login, and profile management.",
      "item": [
        {
          "name": "1. Sign Up (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"confirm_password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "description": "Create a new user account with full name, email, and password. Dispatches a 6-digit OTP to the user's email."
          },
          "response": [
            {
              "name": "Successful Sign Up",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password123!\",\n  \"confirm_password\": \"Password123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register/",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "register",
                    ""
                  ]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Account created successfully. A 6-digit verification code has been sent to your email.\",\n  \"data\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"john.doe@example.com\",\n    \"full_name\": \"John Doe\",\n    \"username\": \"john.doe\",\n    \"role\": \"user\",\n    \"auth_provider\": \"email\",\n    \"is_verified\": false,\n    \"is_active\": true,\n    \"date_joined\": \"2026-09-08T15:00:00Z\",\n    \"created_at\": \"2026-09-08T15:00:00Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "2. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.tokens.access);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.tokens.refresh);",
                  "    console.log(\"Access and Refresh tokens saved successfully.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{otpCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp",
                ""
              ]
            },
            "description": "Verifies the 6-digit OTP sent to the email address. Upon success, activates/verifies the user and returns JWT access and refresh tokens."
          },
          "response": [
            {
              "name": "Successful OTP Verification",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"482910\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/verify-otp/",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "verify-otp",
                    ""
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Email verified successfully.\",\n  \"tokens\": {\n    \"access\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n  },\n  \"user\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"email\": \"john.doe@example.com\",\n    \"full_name\": \"John Doe\",\n    \"username\": \"john.doe\",\n    \"role\": \"user\",\n    \"auth_provider\": \"email\",\n    \"is_verified\": true,\n    \"is_active\": true,\n    \"date_joined\": \"2026-09-08T15:00:00Z\",\n    \"created_at\": \"2026-09-08T15:00:00Z\"\n  }\n}"
            }
          ]
        },
