        {
          "name": "5. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.access);",
                  "    console.log(\"New Access token saved successfully.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
