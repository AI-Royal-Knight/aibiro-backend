            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Exchange an unexpired refresh token for a newly issued access token."
          }
