    {
      "name": "Projects & Documents",
      "description": "Endpoints for Client Project management, accreditation surveys, and file attachments (PDF, DOCX, XLSX, etc.).",
      "item": [
        {
          "name": "1. Create Project (Required: name, company_name, status)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
